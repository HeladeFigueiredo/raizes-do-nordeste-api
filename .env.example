# Copie este arquivo para ".env" e ajuste os valores. O ".env" NÃO vai para o GitHub.
SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
JWT_SECRET_KEY=troque-por-outro-valor-longo-e-aleatorio
# Validade do token de acesso, em minutos
JWT_EXPIRA_MINUTOS=60
# Desenvolvimento (SQLite). Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/raizes
DATABASE_URL=sqlite:///raizes.db
# Chave que o gateway de pagamento envia (X-API-Key) ao chamar /pagamentos/retorno.
# Este valor serve para desenvolvimento e para o Postman. Em produção, troque por um segredo próprio.
GATEWAY_API_KEY=chave-do-gateway-dev
# Senha dos usuários de exemplo criados por "flask seed"
SEED_PASSWORD=senha123
